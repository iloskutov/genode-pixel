LICENSE   := GPLv2
VERSION   := git
DOWNLOADS := google_s5300.git

#
# Samsung modem interface driver (cpif) of the Pixel 7's S5300 modem, used
# by the modem driver. The revision is the one of the kernel manifest
# android-gs-pantah-6.1-android16.
#
URL(google_s5300) := https://android.googlesource.com/kernel/google-modules/radio/samsung/s5300
REV(google_s5300) := 232fb16b3dbc3c4126d9ac0b2a0f0f514e1290c8
DIR(google_s5300) := src/google_s5300

PATCHES   := patches/google_s5300/0001-legacy-link-yield-on-full-ring.patch
PATCH_OPT := -p1
