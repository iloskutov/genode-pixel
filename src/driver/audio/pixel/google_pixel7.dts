/dts-v1/;

/*
 * \brief  Device tree of the audio driver of the Google Pixel 7
 * \author Ivan Loskutov
 * \date   2026-10-29
 *
 * The tree describes what the audio driver needs: the Trusty client, the
 * non-secure mailbox of the security chip (GSA) and the register range of
 * the GSA's S2MPU, the always-on compute (AoC) with its SysMMU, IOMMU
 * group, DRAM and three mailboxes, the AoC's sound card with its ALSA
 * platforms and routing component, the SPI controller of USI7 with the two
 * CS35L41 speaker amplifiers, the GPIO banks of the amplifiers' chip
 * selects, resets, and interrupts, and the interrupt controller. The values
 * are those of the vendor's device tree for the phone (gs201-panther), with
 * these changes:
 *
 * - Trusty keeps only its 'virtio' child. The component has no driver for
 *   the 'irq' and 'log' children and uses none of the DMA heaps.
 * - The GSA node is without its GSC child and without its 's2mpu'
 *   reference, which only pKVM uses.
 * - The AoC node has the additional property 'skip-monitor-online-reset':
 *   the AoC is not restarted when it does not answer within 5 seconds.
 * - The AoC node is without its pin-control states: the component has no
 *   pin controller for them.
 * - The SPI controller runs in CPU mode (FIFO): 'dma-names' is left out
 *   ('dmas' and 'dma-mode' are absent in the vendor's tree already).
 * - The SPI controller and the amplifiers are without their clocks, the
 *   USI system register, and their pin-control states: the platform driver
 *   switches the clocks and sets the USI to SPI, the pin driver configures
 *   the pins. A reference to a node without a driver would make the driver
 *   core defer the probe forever.
 * - The amplifiers' SPI clock is 3.25 MHz instead of 25 MHz, the rate the
 *   bus really has: the platform feeds the controller with OSCCLK/2 =
 *   13 MHz, the controller divides it by 4, and the driver cannot change
 *   the rate of the clock.
 * - The sound card keeps its 33 front-end links in their order: the PCM
 *   numbers are the link order, and the AoC's ALSA driver relies on them.
 *   The links of the platforms that the component does not have (compress
 *   offload, VoIP, in-call) use the plain PCM platform instead.
 * - The haptics back end is without its CS40L26 codec and falls back to
 *   the dummy codec: the component has no driver for the CS40L26, and the
 *   card would never register.
 * - The aliases name SPI7 only.
 *
 * The AoC's SysMMU has no driver in the component, but its node must stay
 * enabled: the AoC driver reads the node through 'iommus', and disabled
 * nodes are not unflattened.
 *
 * Nodes that the nodes above reference, but that no driver of the
 * component reads, are kept only as far as the references need them: the
 * two PMICs named by the first AoC mailbox ('main-pmic', 'sub-pmic') with
 * the three regulators that supply the AoC's sensors and the amplifiers,
 * the amplifiers' fixed dummy supply,
 * and the I2C controller of USI7 with the CS40L26 and its codec node, which
 * the sound card's clock list names. The regulators and the codec node keep
 * their properties, the PMICs, the I2C controller, and the CS40L26 keep only
 * compatible, reg, and status. The four regulators are disabled: they
 * have no driver here (the platform driver switches the rails, the
 * regulator calls of the drivers are stubs), and a supply without a device
 * made the driver core defer the probe of the AoC and of the amplifiers
 * forever. A disabled node is not unflattened, so the supply references
 * lead nowhere. Left out are the other reserved-memory regions, the other
 * GPIO banks, all pin states, and all nodes of the vendor's tree that
 * nothing of the above references.
 */

/*
 * SPDX-License-Identifier: GPL-2.0
 */

/ {
	model = "GS201 PANTHER MP based on GS201";
	#address-cells = <2>;
	#size-cells = <1>;
	compatible = "google,GS201 PANTHER", "google,GS201";
	interrupt-parent = <&gic>;

	/* the SPI driver takes the controller's number from the alias */
	aliases {
		spi7 = &spi_7;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/* the AoC DRAM, the only region the component uses */
		aoc_reserve: aoc@94000000 {
			reg = <0 0x94000000 0x3000000>;
			no-map;
		};
	};

	trusty {
		compatible = "android,trusty-smc-v1";

		virtio {
			compatible = "android,trusty-virtio-v1";
		};
	};

	pinctrl@180E0000 {
		compatible = "google,gs201-pinctrl";
		reg = <0 0x180e0000 0x1000>;
		interrupts = <0 0x2c 4>, <0 0x2d 4>, <0 0x2e 4>, <0 0x2f 4>,
		             <0 0x30 4>, <0 0x31 4>, <0 0x32 4>, <0 0x33 4>,
		             <0 0x34 4>, <0 0x35 4>, <0 0x36 4>, <0 0x37 4>,
		             <0 0x38 4>, <0 0x39 4>, <0 0x3a 4>, <0 0x3b 4>,
		             <0 0x3c 4>, <0 0x3d 4>, <0 0x3e 4>, <0 0x3f 4>,
		             <0 0x40 4>, <0 0x41 4>;

		/* pin 3: interrupt of the left amplifier */
		gpa6: gpa6 {
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
			interrupts = <0 0x2c 4>,
			             <0 0x2d 4>,
			             <0 0x2e 4>,
			             <0 0x2f 4>,
			             <0 0x30 4>,
			             <0 0x31 4>,
			             <0 0x32 4>,
			             <0 0x33 4>;
		};

		/* pin 6: interrupt of the right amplifier */
		gpa8: gpa8 {
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
			interrupts = <0 0x38 4>,
			             <0 0x39 4>,
			             <0 0x3a 4>,
			             <0 0x3b 4>,
			             <0 0x3c 4>,
			             <0 0x3d 4>,
			             <0 0x3e 4>,
			             <0 0x3f 4>;
		};
	};

	pinctrl@10840000 {
		compatible = "google,gs201-pinctrl";
		reg = <0 0x10840000 0x1000>;
		interrupts = <0 0x298 4>;

		/* pin 3: chip select of the left amplifier */
		gpp14: gpp14 {
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		/* pin 1: reset line of the left amplifier */
		gpp17: gpp17 {
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

	};

	pinctrl@10C40000 {
		compatible = "google,gs201-pinctrl";
		reg = <0 0x10c40000 0x1000>;
		interrupts = <0 0x2ab 4>;

		/* pin 1: chip select of the right amplifier */
		gpp22: gpp22 {
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		/* pin 2: reset line of the right amplifier */
		gpp25: gpp25 {
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};
	};

	iommu_group_aoc: iommu_group_aoc {
		compatible = "samsung,sysmmu-group";
	};

	/* no driver, but must stay enabled (see above) */
	sysmmu_asoc: sysmmu@1A090000 {
		compatible = "samsung,sysmmu-v8";
		reg = <0 0x1a090000 0x10000>;
		interrupts = <0 0x76 4>,
		             <0 0x77 4>;
		qos = <0x0f>;
		sysmmu,secure-irq;
		sysmmu,secure_base = <0x1a0a0000>;
		port-name = "ASOC";
		#iommu-cells = <0>;
		sysmmu,default_tlb = <0x0a>;
		sysmmu,tlb_property = <1 0x0a 0x300 0x300010>,
		                      <2 0x0a 0x300 0x3c0008>,
		                      <3 0x0a 0x300 0x3c000c>,
		                      <4 0x0a 0x300 0x3c0000>;
	};

	mbox_aoc: mbox@176a0000 {
		acpm-ipc-channel = <2>;
		sub-pmic = <&s2mpg13>;
		main-pmic = <&s2mpg12>;
		compatible = "google,mailbox-whitechapel";
		#address-cells = <2>;
		#size-cells = <1>;
		reg = <0 0x18300000 0x1000>;
		interrupts = <0 0x4b 4>;
		mbox-name = "aoc2ap";
		#mbox-cells = <1>;
		wc-mbox-non-wake-channels = <0x7000>;
	};

	mbox_aoc_f1: mbox@18320000 {
		compatible = "google,mailbox-whitechapel";
		#address-cells = <2>;
		#size-cells = <1>;
		reg = <0 0x18320000 0x1000>;
		interrupts = <0 0x4c 4>;
		mbox-name = "aoc_f1_ap";
		#mbox-cells = <1>;
		wc-mbox-non-wake-channels = <0xf000>;
	};

	mbox_aoc_p6: mbox@18340000 {
		compatible = "google,mailbox-whitechapel";
		#address-cells = <2>;
		#size-cells = <1>;
		reg = <0 0x18340000 0x1000>;
		interrupts = <0 0x4d 4>;
		mbox-name = "aoc_p6_ap";
		#mbox-cells = <1>;
		wc-mbox-non-wake-channels = <0xf000>;
	};

	aoc@19000000 {
		aoc-board-rev = <0x10000>;
		aoc-board-id = <0x30401>;
		aoc-board-cfg = "P10";
		sensor_power_list = "sensor_1v8", "sensor_3v3";
		sensor_3v3-supply = <&s2mpg13_ldo5>;
		sensor_1v8-supply = <&s2mpg13_ldo7>;
		compatible = "google,aoc";
		reg = <0 0x19000000 0x1000000>,
		      <0 0x181d0000 0x1000>,
		      <0 0x1a0b0000 0x1000>,
		      <0 0x1a060000 0x5000>;
		reg-names = "blk_aoc", "aoc_req", "aoc_s2mpu", "ssmt_aoc";
		interrupts = <0 0x74 4>;
		interrupt-names = "watchdog";
		gsa-enabled = "true";
		iommus = <&sysmmu_asoc>;
		memory-region = <&aoc_reserve>;
		samsung,iommu-group = <&iommu_group_aoc>;
		mbox-channels = <0x30>;
		mbox-names = "aoc2ap", "aoc_f1_ap";
		mboxes = <&mbox_aoc 0>, <&mbox_aoc 1>, <&mbox_aoc 2>,
		         <&mbox_aoc 3>, <&mbox_aoc 4>, <&mbox_aoc 5>,
		         <&mbox_aoc 6>, <&mbox_aoc 7>, <&mbox_aoc 8>,
		         <&mbox_aoc 9>, <&mbox_aoc 10>, <&mbox_aoc 11>,
		         <&mbox_aoc 12>, <&mbox_aoc 13>, <&mbox_aoc 14>,
		         <&mbox_aoc 15>, <&mbox_aoc_f1 0>, <&mbox_aoc_f1 1>,
		         <&mbox_aoc_f1 2>, <&mbox_aoc_f1 3>, <&mbox_aoc_f1 4>,
		         <&mbox_aoc_f1 5>, <&mbox_aoc_f1 6>, <&mbox_aoc_f1 7>,
		         <&mbox_aoc_f1 8>, <&mbox_aoc_f1 9>, <&mbox_aoc_f1 10>,
		         <&mbox_aoc_f1 11>, <&mbox_aoc_f1 12>, <&mbox_aoc_f1 13>,
		         <&mbox_aoc_f1 14>, <&mbox_aoc_f1 15>, <&mbox_aoc_p6 0>,
		         <&mbox_aoc_p6 1>, <&mbox_aoc_p6 2>, <&mbox_aoc_p6 3>,
		         <&mbox_aoc_p6 4>, <&mbox_aoc_p6 5>, <&mbox_aoc_p6 6>,
		         <&mbox_aoc_p6 7>, <&mbox_aoc_p6 8>, <&mbox_aoc_p6 9>,
		         <&mbox_aoc_p6 10>, <&mbox_aoc_p6 11>, <&mbox_aoc_p6 12>,
		         <&mbox_aoc_p6 13>, <&mbox_aoc_p6 14>, <&mbox_aoc_p6 15>;
		acpm-ipc-channel = <0x0d>;
		force-vnom = <0>;
		gsa-device = <&gsa>;
		pcu-base = <0xa00000>;
		gpio-base = <0xd70000>;
		pcu-db-set-offset = <0xd004>;
		pcu-db-clr-offset = <0xd008>;
		cp-aperture-start-offset = <0x7fdf80>;
		cp-aperture-end-offset = <0x7fffff>;
		clock-divider = <1>;
		channel-max-pending-msgs = <0x80>;
		block-channel-threshold = <0x40>;
		notify-on-state-transition = "true";
		hotword-supported = "true";
		chre-supported = "true";
		/* not in the vendor's tree */
		skip-monitor-online-reset;
	};

	V_SYS_dummy: cs35l41_dummy_regulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "V_SYS_DUMMY";
		status = "disabled";
		regulator-min-microvolt = <4200000>;
		regulator-max-microvolt = <4200000>;
		regulator-boot-on;
		regulator-always-on;
	};

	aoc_pcm_ep: aoc_pcm_drv {
		compatible = "google-aoc-snd-pcm";
	};

	aoc_voice_ep: aoc_voice_drv {
		compatible = "google-aoc-snd-voice";
	};

	aud_aoc_path: aoc_path {
		#sound-dai-cells = <1>;
		compatible = "google-aoc-path";
	};

	aoc_nohost_drv: aoc_nohost {
		compatible = "google-aoc-snd-nohost";
	};

	sound-aoc {
		compatible = "google-aoc-snd-card";
		aoc-card-name = "google,aoc-snd-card";

		clks {
			sys {
				sys@cs35l41_r {
					out_mul = <1>;
					in_mul = <1>;
					srcid = <0>;
					id = <0>;
					src = "BCLK";
					comp = <&cs35l41_r>;
				};

				sys@cs35l41_l {
					out_mul = <1>;
					in_mul = <1>;
					srcid = <0>;
					id = <0>;
					src = "BCLK";
					comp = <&cs35l41_l>;
				};

				sys@cs40l26_codec {
					out_mul = <1>;
					in_mul = <1>;
					srcid = <0>;
					id = <0>;
					src = "BCLK";
					comp = <&cs40l26_codec>;
				};
			};
		};

		dai_link {
			fe_ep1_rx {
				dai-name = "audio_playback0";
				stream-name = "EP1 playback";
				id = <0>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep2_rx {
				dai-name = "audio_playback1";
				stream-name = "EP2 playback";
				id = <1>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 1>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep3_rx {
				dai-name = "audio_playback2";
				stream-name = "EP3 playback";
				id = <2>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 2>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep4_rx {
				dai-name = "audio_playback3";
				stream-name = "EP4 playback";
				id = <3>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 3>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep5_rx {
				dai-name = "audio_playback4";
				stream-name = "EP5 playback";
				id = <4>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 4>;
				};

				platform {
					vorx {
						of_drv = <&aoc_voice_ep>;
					};
				};
			};

			fe_ep6_rx {
				dai-name = "audio_playback5";
				stream-name = "EP6 playback";
				id = <5>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 5>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep7_rx {
				dai-name = "audio_playback6";
				stream-name = "EP7 playback";
				id = <6>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 6>;
				};

				platform {
					rx1 {
						/* vendor: aoc_compr_drv */
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep8_rx {
				dai-name = "audio_haptics";
				stream-name = "EP8 playback";
				id = <7>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 7>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep1_tx {
				dai-name = "audio_capture0";
				stream-name = "EP1 capture";
				id = <0x40000000>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000000>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep2_tx {
				dai-name = "audio_capture1";
				stream-name = "EP2 capture";
				id = <0x40000001>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000001>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep3_tx {
				dai-name = "audio_capture2";
				stream-name = "EP3 capture";
				id = <0x40000002>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000002>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep4_tx {
				dai-name = "audio_capture3";
				stream-name = "EP4 capture";
				id = <0x40000003>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000003>;
				};

				platform {
					votx {
						of_drv = <&aoc_voice_ep>;
					};
				};
			};

			fe_ep5_tx {
				dai-name = "ultrasonic_capture";
				stream-name = "EP5 capture";
				id = <0x40000004>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000004>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_ep6_tx {
				dai-name = "audio_capture5";
				stream-name = "EP6 capture";
				id = <0x40000005>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x40000005>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_nohost1_rx {
				dai-name = "nohost1 playback";
				stream-name = "nohost1 playback";
				id = <0x20000008>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x20000008>;
				};

				platform {
					rx1 {
						of_drv = <&aoc_nohost_drv>;
					};
				};
			};

			fe_nohost1_tx {
				dai-name = "nohost1 capture";
				stream-name = "nohost1 capture";
				id = <0x60000008>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x60000008>;
				};

				platform {
					tx1 {
						of_drv = <&aoc_nohost_drv>;
					};
				};
			};

			fe_voip_rx {
				dai-name = "audio_voip_rx";
				stream-name = "audio_voip_rx";
				id = <0x0a>;
				dynamic;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x0a>;
				};

				platform {
					rx1 {
						/* vendor: aoc_voip_drv */
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_voip_tx {
				dai-name = "audio_voip_tx";
				stream-name = "audio_voip_tx";
				id = <0x4000000a>;
				dynamic;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x4000000a>;
				};

				platform {
					tx1 {
						/* vendor: aoc_voip_drv */
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_incall_pb0_rx {
				dai-name = "audio_incall_pb_0";
				stream-name = "audio_incall_pb_0";
				id = <0x0b>;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x0b>;
				};

				platform {
					rx1 {
						/* vendor: aoc_incall_drv */
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_incall_pb1_rx {
				dai-name = "audio_incall_pb_1";
				stream-name = "audio_incall_pb_1";
				id = <0x0c>;
				playback;

				cpu {
					sound-dai = <&aud_aoc_path 0x0c>;
				};

				platform {
					rx1 {
						/* vendor: aoc_incall_drv */
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_incall_cap0_tx {
				dai-name = "audio_incall_cap_0";
				stream-name = "audio_incall_cap_0";
				id = <0x4000000d>;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x4000000d>;
				};

				platform {
					tx1 {
						/* vendor: aoc_incall_drv */
						of_drv = <&aoc_pcm_ep>;
					};
				};
			};

			fe_incall_cap1_tx {
				dai-name = "audio_incall_cap_1";
				stream-name = "audio_incall_cap_1";
				id = <0x4000000e>;
				capture;

				cpu {
					sound-dai = <&aud_aoc_path 0x4000000e>;
				};

