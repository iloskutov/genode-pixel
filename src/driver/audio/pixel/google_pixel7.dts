	gsa: gsa-ns {
		compatible = "google,gs101-gsa-v1";
		#address-cells = <2>;
		#size-cells = <1>;
		reg = <0 0x17c90000 0x1000>;
		interrupts = <0 0x16b 4>;
	};

	/* reduced to the path of the CS40L26 codec (see above) */
	hsi2c@10970000 {
		compatible = "samsung,exynos5-hsi2c";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0 0x10970000 0x1000>;
		status = "ok";

		cs40l26a@43 {
			status = "okay";
			reg = <0x43>;
			compatible = "cirrus,cs40l26a";

			cs40l26_codec: cs40l26_codec@snd {
				status = "okay";
				compatible = "cs40l26-codec";
				#sound-dai-cells = <1>;
			};
		};
	};

	/* CPU mode (FIFO): without 'dma-names' (see above) */
	spi_7: spi@10960000 {
		cs-gpios = <&gpp14 3 0>,
		           <&gpp22 1 0>;
		compatible = "samsung,exynos-spi";
		samsung,spi-fifosize = <0x40>;
		swap-mode;
		#address-cells = <1>;
		#size-cells = <0>;
		clock-names = "ipclk_spi", "gate_spi_clk";
		interrupts = <0 0x2a8 4>;
		samsung,usi-offset = <0x18>;
		reg = <0 0x10960000 0x1000>;
		status = "okay";

		cs35l41_r: cs35l41@1 {
			cirrus,right-channel-amp;
			cirrus,hibernate-enable;
			cirrus,hw-noise-gate-select = <0x3f>;
			cirrus,tuning-has-prefix;
			cirrus,asp-sdout-hiz = <3>;
			cirrus,boost-cap-microfarad = <0x1e>;
			cirrus,boost-ind-nanohenry = <0x3e8>;
			cirrus,boost-peak-milliamp = <0xdac>;
			VP-supply = <&V_SYS_dummy>;
			VA-supply = <&s2mpg13_bucka>;
			reset-gpios = <&gpp25 2 0>;
			interrupts = <6 0 0>;
			interrupt-parent = <&gpa8>;
			status = "okay";
			reg = <1>;
			spi-max-frequency = <3250000>;  /* vendor: 25 MHz */
			compatible = "cirrus,cs35l41";
			sound-name-prefix = "R";
			#sound-dai-cells = <1>;

			controller-data {
				samsung,spi-chip-select-mode = <1>;
				samsung,spi-feedback-delay = <1>;
				cs-gpio = <&gpp22 1 0>;
			};

			cirrus,gpio-config2 {
				cirrus,gpio-output-enable;
				cirrus,gpio-src-select = <5>;
			};
		};

		cs35l41_l: cs35l41@0 {
			cirrus,hibernate-enable;
			cirrus,hw-noise-gate-select = <0x3f>;
			cirrus,tuning-has-prefix;
			cirrus,asp-sdout-hiz = <3>;
			cirrus,boost-cap-microfarad = <0x1e>;
			cirrus,boost-ind-nanohenry = <0x3e8>;
			cirrus,boost-peak-milliamp = <0xdac>;
			VP-supply = <&V_SYS_dummy>;
			VA-supply = <&s2mpg13_bucka>;
			reset-gpios = <&gpp17 1 0>;
			interrupts = <3 0 0>;
			interrupt-parent = <&gpa6>;
			status = "okay";
			reg = <0>;
			spi-max-frequency = <3250000>;  /* vendor: 25 MHz */
			compatible = "cirrus,cs35l41";
			#sound-dai-cells = <1>;

			controller-data {
				samsung,spi-chip-select-mode = <1>;
				samsung,spi-feedback-delay = <1>;
				cs-gpio = <&gpp14 3 0>;
			};

			cirrus,gpio-config2 {
				cirrus,gpio-output-enable;
				cirrus,gpio-src-select = <5>;
			};
		};
	};

	s2mpu_gsa@17c60000 {
		compatible = "google,s2mpu";
		reg = <0 0x17c60000 0x10000>;
		interrupts = <0 0x16e 4>;
		off-at-boot;
	};

	gic: interrupt-controller@10400000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <3>;
		interrupt-controller;
		reg = <0 0x10400000 0x10000>,
		      <0 0x10440000 0x100000>;
		interrupts = <1 9 4>;
	};

	/* reduced to the path of the PMIC (see above) */
	acpm_mfd_bus@18100000 {
		#size-cells = <0>;
		#address-cells = <1>;
		compatible = "google,i2c-acpm";
		status = "okay";

		s2mpg12: s2mpg12mfd@1f {
			reg = <0x1f>;
			compatible = "samsung,s2mpg12mfd";
		};
	};

	/* reduced to the paths of the PMIC and its regulators (see above) */
	acpm_mfd_bus@18110000 {
		#size-cells = <0>;
		#address-cells = <1>;
		compatible = "google,i2c-acpm";
		status = "okay";

		s2mpg13: s2mpg13mfd@2f {
			reg = <0x2f>;
			compatible = "samsung,s2mpg13mfd";

			regulators {
				s2mpg13_ldo7: LDO7S {
					subsys-name = "Sensors";
					schematic-name = "L7S_SENSORS";
					channel-mux-selection = <0x27>;
					regulator-initial-mode = <3>;
					regulator-boot-on;
					regulator-max-microvolt = <1950000>;
					regulator-min-microvolt = <1600000>;
					regulator-name = "S2MPG13_LDO7";
					status = "disabled";
				};

				s2mpg13_ldo5: LDO5S {
					subsys-name = "Prox";
					schematic-name = "L5S_PROX";
					channel-mux-selection = <0x25>;
					regulator-initial-mode = <3>;
					regulator-boot-on;
					regulator-max-microvolt = <3300000>;
					regulator-min-microvolt = <2500000>;
					regulator-name = "S2MPG13_LDO5";
					status = "disabled";
				};

				s2mpg13_bucka: BUCKA {
					channel-en-index = <8>;
					channel-en-byte-offset = <1>;
					buck_rail;
					subsys-name = "IO";
					schematic-name = "SA";
					channel-mux-selection = <0x0c>;
					regulator-initial-mode = <3>;
					regulator-always-on;
					regulator-max-microvolt = <2100000>;
					regulator-min-microvolt = <1700000>;
					regulator-name = "S2MPG13_BUCKA";
					status = "disabled";
				};
			};
		};
	};
};
