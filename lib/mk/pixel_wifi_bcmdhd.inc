#
# Sources and options of the vendor's WiFi driver (bcmdhd_wlan port) as used
# by the pixel_wifi library
#
# The options are those of the vendor's build for the BCM4389 of the Pixel 7
# without the power management of the bus (deep sleep, out-of-band wakeup,
# runtime PM, ASPM), the provisioned MAC address, the firmware's keep-alive
# offload, and the in-driver supplicant. 'SYNCID_MISMATCH_DEBUG' makes the
# driver count the sync IDs of its scans from 1: the firmware asserts on a
# scan with the ID 0.
#

BCMDHD_SRC := \
	dhd_common.c \
	dhd_ip.c \
	dhd_custom_gpio.c \
	dhd_linux.c \
	dhd_linux_sched.c \
