# PCIe transport
BCMDHD_SRC += \
	dhd_pcie.c \
	dhd_pcie_linux.c \
	dhd_msgbuf.c \
	dhd_flowring.c \
	pcie_core_host.c

# NCI bus support (BCM4389/4398)
BCMDHD_SRC += \
	nciutils.c \
	nciutils_host.c \
	hal_nci_cmn.c

# Load balancing
BCMDHD_SRC += dhd_linux_lb.c

# Event log filter
BCMDHD_SRC += dhd_event_log_filter.c

# Google platform
BCMDHD_SRC += dhd_custom_google.c

# CID check
BCMDHD_SRC += dhd_custom_cis.c

# DSCP policy
BCMDHD_SRC += dhd_cfg_dscp_policy.c

# WBRC (WLAN-BT regon coordinator)
BCMDHD_SRC += wb_regon_coordinator.c

# Packet logging
BCMDHD_SRC += dhd_pktlog.c

# Status logging
BCMDHD_SRC += dhd_statlog.c

# Cellular channel avoidance
BCMDHD_SRC += wl_cfg_cellavoid.c

SRC_C += $(BCMDHD_SRC)

