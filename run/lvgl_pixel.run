#
# LVGL on the Google Pixel 7: a scrolling list and the on-screen keyboard
#
# 'test-lvgl' of the repository 'goa-packages' draws with LVGL 9.6 (its
# library 'lvgl', software rendering) into a GUI session that covers the
# panel and takes the touch events of 'ft3658_touch'. The screen holds a
# list of 40 entries, a text area, and LVGL's keyboard. What the user does
# is logged:
#
#   test-lvgl: tap: Entry 7
#   test-lvgl: text: hello
#   test-lvgl: submitted: hello
#
# and LVGL logs its frame rate and render time every second. Scroll the list
# with a swipe (it keeps moving after the finger leaves), tap entries, and
# type on the keyboard; its OK key submits the text. LVGL renders in four
# threads on the four fast cores.
#
# The library and the test come from the depot of this tree, at the versions
# below. Build them with Goa, from 'goa-packages':
#
#   goa export -C lvgl
#   goa export -C test-lvgl
#

assert {[have_board google_pixel7]}

build {
	core init lib/ld timer
	driver/platform/gs201
	driver/pin/gs201
	driver/framebuffer/exynos
	driver/touch/ft3658
	server/event_filter
	server/nitpicker
	lib/libc lib/libm lib/vfs
}

create_boot_directory

import_from_depot iloskutov_pixel7/src/lvgl/2026-11-11 \
                  iloskutov_pixel7/src/test-lvgl/2026-11-11

install_config {
config
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default | caps: 100 | ram: 1M

+ affinity-space | width: 8 | height: 1

+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start platform | caps: 200 | ram: 2M | managing_system: yes
  + binary gs201_platform
  + provides
    + service Platform
    + service Dma
  + config
    + policy | label_prefix: gs201_pio | info: yes
      + device gpio_alive
      + device gpio_far_alive
      + device gpio_peric1
    + policy | label_prefix: exynos_fb | info: yes
      + device dpu
      + device dsim0
    + policy | label_prefix: ft3658_touch | info: yes
      + device spi0
  + route
    + service Timer | + child timer
    + any-service   | + parent

+ start gs201_pio | caps: 150 | ram: 2M
  + provides
    + service Pin_state
    + service Pin_control
    + service IRQ
  + config
    + out panel_reset  | bank: gpa7  | index: 1 | default: yes
    + select spi0_clk  | bank: gpp20 | index: 0 | function: 3
    + select spi0_mosi | bank: gpp20 | index: 1 | function: 3
    + select spi0_miso | bank: gpp20 | index: 2 | function: 3
    + out touch_reset  | bank: gpp23 | index: 2 | default: yes
    + out spi0_cs      | bank: gpp20 | index: 3 | default: yes
    + in  touch_int    | bank: gpa7  | index: 0 | irq: falling
    + policy | label: exynos_fb -> gpa7-1     | pin: panel_reset
    + policy | label: ft3658_touch -> gpp23-2 | pin: touch_reset
    + policy | label: ft3658_touch -> gpp20-3 | pin: spi0_cs
    + policy | label: ft3658_touch -> 84      | pin: touch_int
  + route
    + service Platform | + child platform
    + any-service      | + parent

+ start nitpicker | caps: 150 | ram: 8M
  + provides
    + service Gui
    + service Capture
    + service Event
  + config
    + capture
    + event
    + domain default | layer: 1 | content: client | label: no | focus: click
                     | hover: always
    + default-policy | domain: default
  + route
    + service Timer | + child timer
    + any-service   | + parent

+ start event_filter | caps: 90 | ram: 1280K
  + provides | + service Event
  + config
    + output | + input touch
    + policy | label: touch | input: touch
  + route
    + service Event | + child nitpicker
    + service Timer | + child timer
    + any-service   | + parent

+ start exynos_fb | caps: 500 | ram: 96M
  + config | display: on
  + route
    + service ROM | label: dtb | + parent | label: exynos_fb-google_pixel7.dtb
    + service Platform    | + child platform
    + service Dma         | + child platform
    + service Pin_state   | + child gs201_pio
    + service Pin_control | + child gs201_pio
    + service Capture     | + child nitpicker
    + service Timer       | + child timer
    + any-service         | + parent

+ start ft3658_touch | caps: 300 | ram: 32M
  + route
    + service ROM | label: dtb | + parent | label: ft3658_touch-google_pixel7.dtb
    + service Platform    | + child platform
    + service Dma         | + child platform
    + service Pin_state   | + child gs201_pio
    + service Pin_control | + child gs201_pio
    + service IRQ         | + child gs201_pio
    + service Event       | + child event_filter | label: touch
    + service Timer       | + child timer
    + any-service         | + parent

+ start test-lvgl | caps: 300 | ram: 64M
  . the fast cores: Cortex-A78 4 and 5, Cortex-X1 6 and 7; one draw
  . thread per core
  + affinity | xpos: 4 | width: 4
  + config | verbose_input: yes
    + libc    | stdout: /dev/log | stderr: /dev/log
    + pthread | placement: all-cpus
    + vfs     | + dir dev | + log
  + route
    + service Gui   | + child nitpicker
    + service Timer | + child timer
    + any-service   | + parent
-
}

copy_file [file join [repository_contains board/google_pixel7/devices] \
                     board google_pixel7 devices] [run_dir]/genode/devices

build_boot_image [build_artifacts]

run_genode_until forever
