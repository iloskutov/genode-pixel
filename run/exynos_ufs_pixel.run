#
# UFS storage driver for the Google Pixel 7
#
# The driver 'exynos_ufs' provides the logical units of the UFS storage as
# Block sessions and reports them, the report is logged by 'report_rom'.
# 'block_tester' reads the first 256 MiB of the unit 'sda' and logs the
# throughput. The unit is read-only for the tester, nothing is written to
# the storage. The clocks and the I/O coherency of the host controller are
# provided by 'gs201_platform'.
#

assert {[have_board google_pixel7]}

build {
	core init lib/ld timer
	server/report_rom
	app/block_tester
	driver/platform/gs201
	driver/ufs/exynos
}

create_boot_directory

install_config {
config
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start report_rom | ram: 2M
  + provides
    + service Report
    + service ROM
  + config | verbose: yes
  + route | + any-service | + parent

+ start platform | caps: 150 | ram: 2M | managing_system: yes
  + binary gs201_platform
  + provides
    + service Platform
    + service Dma
  + config
    + policy | label_prefix: exynos_ufs | info: yes
      + device ufs
  + route
    + service Timer | + child timer
    + any-service   | + parent

+ start exynos_ufs | caps: 500 | ram: 128M
  + provides | + service Block
  + config | report: yes
    + default-policy | device: sda | writeable: no
  + route
    + service ROM | label: dtb | + parent | label: exynos_ufs-google_pixel7.dtb
    + service Platform | + child platform
    + service Dma      | + child platform
    + service Report   | + child report_rom
    + service Timer    | + child timer
    + any-service      | + parent

+ start block_tester | ram: 64M
  + config | verbose: no | report: no | log: yes | stop_on_error: no
    + tests
      + sequential | length: 256M | size: 1M | io_buffer: 8M | batch: 4
  + route
    + service Block | + child exynos_ufs
    + service Timer | + child timer
    + any-service   | + parent
-
}

copy_file [file join [repository_contains board/google_pixel7/devices] \
                     board google_pixel7 devices] [run_dir]/genode/devices

build_boot_image [build_artifacts]

run_genode_until forever
