#
# The modem stack of the Google Pixel 7: answers calls and logs SMS
#
# The phone's own modem daemons boot and drive the CP (modem_stack.inc),
# 'modem_console' switches the modem on, accepts every incoming call and
# logs every received SMS:
#
#   modem_console: SIM: yes
#   modem_console: network: registered <operator> lte
#   modem_console: SMS from +... at ...: <text>
#   modem_console: call: incoming +...
#   modem_console: accepting the call of +...
#
# The files of the phone are not part of Genode, see 'tool/pull_modem_files'.
#
#   make run/modem_stack_pixel KERNEL=hw BOARD=google_pixel7
#
# Environment variables:
#
#   SIM_PIN=<pin>       PIN of the SIM, if it needs one
#   ATTACH_APN=<apn>    APN of the initial attach (default "internet")
#   RIL_LOG_LEVEL=<l>   log level of rild: verbose|debug|info|warn|error
#                       (default warn)
#

assert {[have_board google_pixel7]}

source [genode_dir]/repos/pixel/run/modem_pixel.inc
source [genode_dir]/repos/pixel/run/modem_stack.inc

proc env_or { name default } {
	return [expr {[info exists ::env($name)] ? $::env($name) : $default}] }

set sim_pin       [env_or SIM_PIN ""]
set attach_apn    [env_or ATTACH_APN internet]
set ril_log_level [env_or RIL_LOG_LEVEL warn]

if {[lsearch -exact {verbose debug info warn error} $ril_log_level] < 0} {
	puts stderr "Error: RIL_LOG_LEVEL must be verbose, debug, info, warn, or error"
	exit 1
}

build [list core init lib/ld timer {*}[modem_stack_targets]]

create_boot_directory

modem_stack_import

set fw_version [modem_stack_files]

set console_attrs " | attach_apn: $attach_apn"
if {$sim_pin ne ""} { append console_attrs " | pin: $sim_pin" }

install_config {
config
+ affinity-space | width: 8 | height: 1

+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start report_rom | ram: 4M
  + provides
    + service Report
    + service ROM
  + config
    + policy | label: rild_modem -> config    | report: modem_console -> config
    + policy | label: modem_console -> state | report: rild_modem -> state
  + route | + any-service | + parent
} [modem_pixel_drivers] [modem_stack_start_nodes $fw_version $ril_log_level \
      [string cat "  + config\n" [modem_chardev_policies "    "] "  + route"]] {
+ start modem_console
  + config} $console_attrs {
  + route
    + service ROM | label: state | + child report_rom
    + service Report            | + child report_rom
    + any-service               | + parent
-
}

copy_file [file join [repository_contains board/google_pixel7/devices] \
                     board google_pixel7 devices] [run_dir]/genode/devices

build_boot_image [build_artifacts]

run_genode_until forever
