#
# USB serial port on the Google Pixel 7
#
# 'usb_acm' is a CDC ACM function of the driver 'exynos_usb_gadget' and serves a
# Terminal session. 'test-terminal_raw_echo' returns every byte of this session
# unchanged. The PC sees a serial port (Linux: /dev/ttyACM*).
#
# The test succeeded when the tool 'usb_echo_check' on the PC ends with PASS. It
# finds the port by the USB IDs 1d6b:0104 and checks the echo of several sizes.
#
# Building
# ~~~~~~~~
#
# The run script builds the drivers and the base system from this tree, and names
# a missing port. 'usb_acm' and the echo are a package of the repository
# 'goa-packages'. The run script neither builds nor downloads it: it takes it from
# the depot of this tree, at the version at 'import_from_depot' below, and stops
# with "missing depot archives" if it is not there. Get it in one of two ways.
#
# Build it with Goa, from 'goa-packages', after the API archives of the tree are
# created (see the README of 'goa-packages' for this and the prerequisites):
#
#   goa export -C usb_acm
#
# Or download the published archive, from the Genode directory, once the depot
# user is set up (README of 'goa-packages', "Using the depot in a Genode tree").
# The dependencies come along, the signatures are checked:
#
#   tool/depot/download iloskutov_pixel7/bin/arm_v8a/usb_acm/2026-11-01
#
# With a new version of the package, update the version in this file.
#
# Running
# ~~~~~~~
#
# From the build directory, this creates 'var/run/usb_acm_pixel.img':
#
#   make run/usb_acm_pixel KERNEL=hw BOARD=google_pixel7
#
# To also boot the image on the phone and capture the log, from the Genode
# directory, and on the PC during the capture:
#
#   repos/pixel/tool/device_test usb_acm_pixel 90
#   repos/pixel/tool/usb_echo_check
#

assert {[have_board google_pixel7]}

build {
	core init lib/ld timer
	driver/platform/gs201
	driver/pin/gs201
	driver/i2c/gs201
	driver/usb_gadget/exynos
}

create_boot_directory

import_from_depot iloskutov_pixel7/src/usb_acm/2026-11-01

install_config {
config
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start platform | caps: 150 | ram: 2M | managing_system: yes
  + binary gs201_platform
  + provides
    + service Platform
    + service Dma
  + config
    + policy | label_prefix: gs201_pio | info: yes
      + device gpio_peric1
    + policy | label_prefix: gs201_i2c | info: yes
      + device hsi2c13
    + policy | label_prefix: exynos_usb_gadget | info: yes
      + device usb
      + device usb_phy
  + route
    + service Timer | + child timer
    + any-service   | + parent

+ start gs201_pio | caps: 150 | ram: 2M
  + provides
    + service Pin_state
    + service Pin_control
    + service IRQ
  + config
    + select hsi2c13_scl | bank: gpp25 | index: 0 | function: 2
    + select hsi2c13_sda | bank: gpp25 | index: 1 | function: 2
  + route
    + service Platform | + child platform
    + any-service      | + parent

+ start gs201_i2c | ram: 2M
  + provides | + service I2c
  + config | bus_speed_hz: 400000
    + allow  | bus_address: 0x25
      . the Type-C controller of the MAX77759
    + policy | label_prefix: exynos_usb_gadget | bus_address: 0x25 | max_write: 2
  + route
    + service Platform | + child platform
    + service Timer    | + child timer
    + any-service      | + parent

+ start exynos_usb_gadget | caps: 300 | ram: 32M
  + provides | + service Usb_gadget
  + config | vendor_id:    0x1d6b
           | product_id:   0x0104
           | manufacturer: Genode
           | product:      Pixel 7
           | serial:       0001
           | max_power_ma: 100
    + function | label: acm
  + route
    + service ROM | label: dtb | + parent | label: exynos_usb_gadget-google_pixel7.dtb
    + service Platform | + child platform
    + service Dma      | + child platform
    + service I2c      | + child gs201_i2c
    + service Timer    | + child timer
    + any-service      | + parent

+ start usb_acm | ram: 2M
  + provides | + service Terminal
  + route
    + service Usb_gadget | + child exynos_usb_gadget
    + any-service        | + parent

+ start test-terminal_raw_echo
  + route
    + service Terminal | + child usb_acm
    + any-service      | + parent
-
}

copy_file [file join [repository_contains board/google_pixel7/devices] \
                     board google_pixel7 devices] [run_dir]/genode/devices

build_boot_image [build_artifacts]

run_genode_until forever
