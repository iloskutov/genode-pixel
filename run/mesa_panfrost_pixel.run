#
# Mesa from Goa on the driver from the Genode tree, on the Google Pixel 7
#
# 'test-mesa26_egl' renders with OpenGL ES 2 and with desktop OpenGL on the
# Mali-G710, and checks the pixels with glReadPixels and in the window buffer.
# The test succeeded when it logs "mesa26_egl: PASS".
#
# Building
# ~~~~~~~~
#
# The run script builds 'panthor_gpu' and the libraries of the base system from
# this tree, and names a missing port. The GPU firmware comes from a port:
#
#   tool/ports/prepare_port mali_firmware
#
# Mesa and the test client are packages of the repository 'goa-packages'. The run
# script neither builds nor downloads them: it takes them from the depot of this
# tree, at the versions at 'import_from_depot' below, and stops with "missing
# depot archives" if they are not there. Get them in one of two ways.
#
# Build them with Goa, from 'goa-packages', after the API archives of the tree
# are created (see the README of 'goa-packages' for this and the prerequisites):
#
#   goa export -C mesa26
#   goa export -C mesa26_egl
#
# Or download the published archives, from the Genode directory, once the depot
# user is set up (README of 'goa-packages', "Using the depot in a Genode tree").
# The dependencies come along, the signatures are checked:
#
#   tool/depot/download iloskutov_pixel7/bin/arm_v8a/mesa26/2026-10-31 \
#                       iloskutov_pixel7/bin/arm_v8a/mesa26_egl/2026-10-31
#
# With a new version of a package, update the version in this file.
#
# Running
# ~~~~~~~
#
# From the build directory, this creates 'var/run/mesa_panfrost_pixel.img':
#
#   make run/mesa_panfrost_pixel KERNEL=hw BOARD=google_pixel7
#
# To also boot the image on the phone and capture the log, from the Genode
# directory:
#
#   repos/pixel/tool/device_test mesa_panfrost_pixel 45
#
# Environment variables:
#
#   GPU_RAM=512M     RAM of the driver
#

assert {[have_board google_pixel7]}

proc env_or { name default } {
	return [expr {[info exists ::env($name)] ? $::env($name) : $default}] }

set gpu_ram [env_or GPU_RAM 512M]
set mali_fw [exec [genode_dir]/tool/ports/current --no-print-directory mali_firmware]/mali_csffw.bin

if {![file isfile $mali_fw]} {
	puts stderr "Error: firmware missing, execute 'tool/ports/prepare_port mali_firmware'"
	exit 1
}

build {
	core init lib/ld timer
	driver/platform/gs201
	driver/gpu/panthor
	lib/libc lib/libm lib/vfs lib/posix lib/zlib lib/stdcxx lib/vfs_gpu
}

create_boot_directory

import_from_depot iloskutov_pixel7/src/mesa26/2026-10-31 \
                  iloskutov_pixel7/src/mesa26_egl/2026-10-31

install_config {
config
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start platform | caps: 150 | ram: 2M | managing_system: yes
  + binary gs201_platform
  + provides
    + service Platform
    + service Dma
  + config
    + policy | label_prefix: panthor_gpu | info: yes
      + device gpu
  + route
    + service Timer | + child timer
    + any-service   | + parent

+ start panthor_gpu | caps: 800 | ram: } $gpu_ram {
  + provides | + service Gpu
  + config | dtb: panthor-google_pixel7.dtb
  + route
    + service Timer    | + child timer
    + service Platform | + child platform
    + service Dma      | + child platform
    + any-service      | + parent

+ start test-mesa26_egl | caps: 1500 | ram: 256M
  + config
    + libc | stdout: /dev/log | stderr: /dev/log | rtc: /dev/rtc
    + vfs
      + dir dev
        + log
        + gpu
        + inline rtc
          : 2000-01-01 00:00
  + route
    + service Timer | + child timer
    + service Gpu   | + child panthor_gpu
    + service ROM   | label: mesa26_gpu.lib.so | + parent | label: mesa26_gpu-panfrost.lib.so
    + any-service   | + parent
-
}

copy_file [file join [repository_contains board/google_pixel7/devices] \
                     board google_pixel7 devices] [run_dir]/genode/devices

copy_file $mali_fw [run_dir]/genode/mali_csffw.bin

build_boot_image [build_artifacts]

run_genode_until forever
