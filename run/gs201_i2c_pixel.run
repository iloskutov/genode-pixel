#
# I2C driver for the Google Pixel 7
#
# The driver 'gs201_i2c' serves the I2C bus of USI13. 'test-i2c_tcpc' reads
# the vendor and product ID of the Type-C controller of the MAX77759 on
# this bus and logs "PASS" if the product ID is the one of the MAX77759.
# The test only writes the register pointer ('max_write: 1'). The clocks
# of the controller are provided by 'gs201_platform', its pins by
# 'gs201_pio'.
#

assert {[have_board google_pixel7]}

build {
	core init lib/ld timer
	driver/platform/gs201
	driver/pin/gs201
	driver/i2c/gs201
	test/i2c_tcpc
}

create_boot_directory

install_config {
config
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start platform | caps: 150 | ram: 2M | managing_system: yes
  + binary gs201_platform
  + provides
    + service Platform
    + service Dma
  + config
    + policy | label_prefix: gs201_pio | info: yes
      + device gpio_peric1
    + policy | label_prefix: gs201_i2c | info: yes
      + device hsi2c13
  + route
    + service Timer | + child timer
    + any-service   | + parent

+ start gs201_pio | caps: 150 | ram: 2M
  + provides
    + service Pin_state
    + service Pin_control
    + service IRQ
  + config
    + select hsi2c13_scl | bank: gpp25 | index: 0 | function: 2
    + select hsi2c13_sda | bank: gpp25 | index: 1 | function: 2
  + route
    + service Platform | + child platform
    + any-service      | + parent

+ start gs201_i2c | ram: 2M
  + provides | + service I2c
  + config | bus_speed_hz: 400000
    + allow  | bus_address: 0x25
      . the Type-C controller of the MAX77759
    + policy | label_prefix: test-i2c_tcpc | bus_address: 0x25 | max_write: 1
  + route
    + service Platform | + child platform
    + service Timer    | + child timer
    + any-service      | + parent

+ start test-i2c_tcpc
  + route
    + service I2c | + child gs201_i2c
    + any-service | + parent
-
}

copy_file [file join [repository_contains board/google_pixel7/devices] \
                     board google_pixel7 devices] [run_dir]/genode/devices

build_boot_image [build_artifacts]

run_genode_until forever
