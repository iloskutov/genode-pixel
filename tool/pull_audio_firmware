#!/bin/sh
#
# \brief  Pull the firmware of the audio path from a Pixel 7 running Android
# \author Ivan Loskutov
# \date   2026-10-29
#
# SPDX-License-Identifier: MIT
#
# The audio driver requests the firmware of the AoC DSP ('aoc.bin') and of
# the DSPs of the two CS35L41 speaker amplifiers (the speaker protection and
# its tuning) as ROM modules, which the run scenarios take from a tar
# archive. The run scenarios also take the vendor's mixer paths
# ('mixer_paths.xml', the control values of Android's audio routes) from
# it, to generate the configuration of the driver. The files are not part
# of Genode. This tool copies them via adb from the phone's
# '/vendor/firmware' and '/vendor/etc' and packs them into the archive.
#
# usage: pull_audio_firmware [<archive>]
#
# The default archive is 'contrib/pixel_audio_firmware.tar' of the Genode
# source tree, the one the run scenarios use unless AUDIO_FW names another.
#
# The phone must run Android with USB debugging enabled. If the files are
# not readable for adb's shell user, execute 'adb root' first (userdebug
# builds, e.g., LineageOS).
#

set -e

FILES="/vendor/firmware/aoc.bin \
       /vendor/firmware/cs35l41-dsp1-spk-prot.wmfw \
       /vendor/firmware/cs35l41-dsp1-spk-prot.bin \
       /vendor/firmware/R-cs35l41-dsp1-spk-prot.bin \
       /vendor/etc/mixer_paths.xml"

GENODE_DIR=$(cd "$(dirname "$0")/../../.." && pwd)

ARCHIVE=${1:-$GENODE_DIR/contrib/pixel_audio_firmware.tar}

command -v adb > /dev/null || { echo "Error: 'adb' is not installed" >&2; exit 1; }

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

adb wait-for-device

NAMES=""
for file in $FILES; do
	name=$(basename "$file")
	if ! adb pull "$file" "$TMP_DIR/$name" > /dev/null; then
		echo "Error: could not pull $file, try 'adb root' first" >&2
		exit 1
	fi
	NAMES="$NAMES $name"
done

mkdir -p "$(dirname "$ARCHIVE")"
tar cf "$ARCHIVE" --owner=0 --group=0 --numeric-owner -C "$TMP_DIR" $NAMES

echo "created $ARCHIVE"
